{
  "name": "gameshtm-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial HTML5 Game Factory for CrazyGames, Poki, and Itch.io",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "build:shared": "npm --workspace=@arcade/shared run build",
    "build:all": "npm run build --workspaces --if-present",
    "pack": "node scripts/pack-game.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
